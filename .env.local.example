# DXシステム側 Supabase プロジェクト
# anon キーはコミットしません。Dashboard → Project Settings → API から
# 取得して、このファイルをコピーした .env.local に貼ってください。
NEXT_PUBLIC_SUPABASE_URL=https://useoasbqbccgaznyhnma.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------
# freee人事労務 連携(任意)
# 未設定でも勤怠打刻そのものは動作します。設定すると打刻を freee に
# 送信できるようになります。すべて「サーバ専用」なので
# NEXT_PUBLIC_ を付けないこと(付けるとブラウザに露出します)。
# ------------------------------------------------------------

# freee OAuth トークンを保存するテーブルは RLS で遮断しているため、
# サーバ側は service role キーで読み書きする。
# Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# freee アプリストアで作成したアプリの認証情報
FREEE_CLIENT_ID=
FREEE_CLIENT_SECRET=

# freee人事労務の事業所ID
FREEE_COMPANY_ID=

# 認可時に要求するスコープ(スペース区切り)。
# 人事労務APIを使うには明示が必要な場合がある。
# freee アプリの設定画面に表示されているスコープをそのまま入れる。
# 変更したら再デプロイして /api/freee/auth から接続し直すこと
FREEE_SCOPE=

# freee アプリに登録したコールバックURL。
# 未設定ならアクセス元のオリジンから自動で組み立てる。
# 例: https://your-app.vercel.app/api/freee/callback
FREEE_REDIRECT_URI=

# /api/freee/auth(freee接続の開始)と定期実行の共有シークレット。
# freee と接続するには必須。長いランダム文字列にすること
CRON_SECRET=

# 手動で取得したリフレッシュトークンを使う場合のみ(通常は不要)。
# 管理画面から /api/freee/auth で接続すれば自動で保存される
FREEE_INITIAL_REFRESH_TOKEN=
